{
  "realm": "nodus-core",
  "enabled": true,
  "displayName": "NodusCore DX-OS",
  "loginTheme": "nodus",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "farmer",
        "description": "Nông hộ / Farmer"
      },
      {
        "name": "coop_admin",
        "description": "Quản trị Hợp tác xã / Cooperative Admin"
      },
      {
        "name": "inspector",
        "description": "Kiểm định viên / Quality Inspector"
      },
      {
        "name": "warehouse_keeper",
        "description": "Thủ kho / Warehouse Keeper"
      },
      {
        "name": "distributor",
        "description": "Nhà phân phối / Distributor"
      }
    ]
  },
  "clients": [
    {
      "clientId": "nodus-frontend",
      "name": "NodusCore Frontend Portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tenant-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
