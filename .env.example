# General
TZ=Asia/Ho_Chi_Minh

# PostgreSQL
POSTGRES_USER=nodus_admin
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=nodus_core

# Keycloak (IAM / SSO)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_password

# Hasura GraphQL Engine
HASURA_GRAPHQL_ADMIN_SECRET=change_me_hasura_secret

# MinIO Object Storage
MINIO_ROOT_USER=nodus_minio
MINIO_ROOT_PASSWORD=change_me_minio_password

# n8n Workflow Automation
N8N_BASIC_AUTH_USER=nodus_n8n
N8N_BASIC_AUTH_PASSWORD=change_me_n8n_password
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
